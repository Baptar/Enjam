    },
    "m_SourceType": 1,
    "m_FunctionName": "CompressDepth",
    "m_FunctionSource": "",
    "m_FunctionBody": "float3 pos = (float3)Position;\nfloat4 clipPos = TransformObjectToHClip(pos);\nclipPos.z = lerp(clipPos.z, 0.0001 * clipPos.w, 0.98);\nOut = pos;"
}

